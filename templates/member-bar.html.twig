{#
/**
 * @file
 * The logged-in member bar (see MemberBar). Member (Gin) theme only.
 *
 * Available variables:
 * - home_url, home_active: Member Resources (node 619), the gold button.
 * - site_url: the public front page ("Public Website").
 * - logo_url: the MakeHaven wordmark, shown centred and not linked.
 * - search_url: where the search box submits (Member Resources, ?q=).
 * - primary, dashboards, account: lists of
 *   { title, description, url, icon, active }. Primary links (member-nav,
 *   usually empty) sit beside Member Resources; dashboards are the viewer's
 *   role dashboards, already access-filtered.
 * - display_name: the viewer's name; links to My Membership.
 * - membership_url, membership_active: My Membership (node 5737).
 * - account: action buttons beside the name (switch back, log out).
 */
#}
<nav class="mh-member-bar" aria-label="{{ 'Member'|t }}">
  <div class="mh-member-bar__inner">
    <div class="mh-member-bar__start">
      <a class="mh-member-bar__home" href="{{ home_url }}"{{ home_active ? ' aria-current="page"' }}>
        <span class="bi bi-grid-3x3-gap-fill" aria-hidden="true"></span><span class="mh-member-bar__home-label">{{ 'Member Resources'|t }}</span>
      </a>
      {% if primary %}
        <ul class="mh-member-bar__primary">
          {% for link in primary %}
            <li><a href="{{ link.url }}" title="{{ link.description ?: link.title }}"{{ link.active ? ' aria-current="page"' }}>
              {% if link.icon %}<span class="bi bi-{{ link.icon }}" aria-hidden="true"></span>{% endif %}<span class="mh-member-bar__label">{{ link.title }}</span></a></li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>

    {% if logo_url %}
      <div class="mh-member-bar__logo">
        <img src="{{ logo_url }}" alt="MakeHaven" width="381" height="54">
      </div>
    {% endif %}

    <div class="mh-member-bar__end">
      {% if dashboards %}
        <details id="mh-dashboards" class="mh-member-bar__drop mh-member-bar__dashboards">
          <summary title="{{ 'Your dashboards'|t }}"><span class="bi bi-speedometer2" aria-hidden="true"></span><span class="mh-member-bar__label">{{ 'Dashboards'|t }}</span><span class="bi bi-chevron-down mh-member-bar__caret" aria-hidden="true"></span></summary>
          <ul class="mh-member-bar__panel mh-member-bar__list">
            {% set groups = dashboards|column('group') %}
            {% set grouped = 'mine' in groups and 'space' in groups %}
            {% for link in dashboards %}
              {% if grouped and (loop.first or link.group != dashboards[loop.index0 - 1].group) %}
                <li class="mh-member-bar__group" role="presentation">{{ link.group == 'mine' ? 'Mine'|t : 'Running the space'|t }}</li>
              {% endif %}
              <li><a href="{{ link.url }}"{{ link.active ? ' aria-current="page"' }}>
                {% if link.icon %}<span class="bi bi-{{ link.icon }}" aria-hidden="true"></span>{% endif %}
                <span class="mh-member-bar__item-text">{{ link.title }}{% if link.description %}<small>{{ link.description }}</small>{% endif %}</span></a></li>
            {% endfor %}
          </ul>
        </details>
      {% endif %}

      <form class="mh-member-bar__search" action="{{ search_url }}" method="get" role="search">
        <label class="mh-member-bar__action-label" for="mh-member-bar-q">{{ 'Find a member page'|t }}</label>
        <span class="bi bi-search" aria-hidden="true"></span>
        <input id="mh-member-bar-q" name="q" type="search" placeholder="{{ 'Find anything…'|t }}" autocomplete="off">
      </form>
      <a class="mh-member-bar__action mh-member-bar__search-link" href="{{ search_url }}" title="{{ 'Find a member page'|t }}">
        <span class="bi bi-search" aria-hidden="true"></span><span class="mh-member-bar__action-label">{{ 'Find a member page'|t }}</span>
      </a>

      <a class="mh-member-bar__site" href="{{ site_url }}" title="{{ 'Public Website'|t }}">
        <span class="bi bi-globe2" aria-hidden="true"></span><span class="mh-member-bar__label">{{ 'Public Website'|t }}</span>
      </a>

      <a class="mh-member-bar__me" href="{{ membership_url }}" title="{{ 'My Membership: profile, billing, badges'|t }}"{{ membership_active ? ' aria-current="page"' }}>
        <span class="bi bi-person-circle" aria-hidden="true"></span>
        <span class="mh-member-bar__name">{{ display_name }}</span>
      </a>

      {% for link in account %}
        <a class="mh-member-bar__action" href="{{ link.url }}" title="{{ link.title }}">
          {% if link.icon %}<span class="bi bi-{{ link.icon }}" aria-hidden="true"></span>{% endif %}<span class="mh-member-bar__action-label">{{ link.title }}</span>
        </a>
      {% endfor %}
    </div>
  </div>
</nav>
