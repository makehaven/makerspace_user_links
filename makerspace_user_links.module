<?php

/**
 * @file
 * Entry point for makerspace_user_links module.
 */

use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\user\UserInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\Core\Url;

/**
 * Implements hook_theme().
 */
function makerspace_user_links_theme(): array {
  return [
    'makerspace_user_links_list' => [
      'variables' => [
        'link_groups' => [],
      ],
      'template' => 'makerspace-user-links-list',
    ],
    'makerspace_user_links_menu_cards' => [
      'variables' => [
        'title' => '',
        'cards' => [],
      ],
      'template' => 'menu-cards',
    ],
    'makerspace_user_links_member_attention' => [
      'variables' => [
        'items' => [],
      ],
      'template' => 'member-attention',
    ],
  ];
}

/**
 * Implements hook_makerspace_member_attention().
 *
 * Starter implementation: surface an unpaid materials-store tab. Other signals
 * (overdue lending, upcoming appointment, unsigned waiver) should be added by
 * the modules that own that data — see makerspace_user_links.api.php.
 */
function makerspace_user_links_makerspace_member_attention(AccountInterface $account): array {
  $items = [];

  // Unpaid materials tab — only if the store module is installed.
  if (\Drupal::moduleHandler()->moduleExists('makerspace_material_store')
    && \Drupal::hasService('makerspace_material_store.tab_limit')) {
    try {
      // Skip the eligibility gates (terms acceptance, Stripe account) so we get
      // the member's REAL outstanding balance. Those gates are "you haven't
      // opted into the tab yet" prompts that belong on the add-to-tab action
      // (StoreController) — not a standing critical banner on /resources. We
      // only nag members who actually have a materials-store tab: a real
      // balance, or an explicit failed-payment/limit block.
      $status = \Drupal::service('makerspace_material_store.tab_limit')->getStatus($account, 0.0, [
        'skip_terms' => TRUE,
        'skip_stripe' => TRUE,
      ]);
      $total = (float) ($status['total'] ?? 0);
      $blocked = !empty($status['blocked']);

      // Failed-payment block (field_store_tab_blocked) early-returns from
      // getStatus with total = 0. Surface it even at $0 pending because the
      // account has been explicitly flagged — that's the most urgent case.
      if ($blocked && $total <= 0) {
        $reason = !empty($status['reason']) ? $status['reason'] : t('Your materials store tab is blocked due to a payment issue.');
        $items[] = [
          'id' => 'material_tab_blocked',
          'severity' => 'critical',
          'message' => $reason,
          'action_label' => t('Resolve store tab'),
          'action_url' => Url::fromRoute('makerspace_material_store.view_tab'),
          'icon' => 'exclamation-octagon',
          'weight' => 5,
          'cache_tags' => ['user:' . $account->id()],
        ];
      }
      // Outstanding balance — a member who is in the program and owes money.
      // Critical if it has hit a limit (blocked), otherwise a gentle reminder.
      elseif ($total > 0) {
        $items[] = [
          'id' => $blocked ? 'material_tab_blocked' : 'material_tab',
          'severity' => $blocked ? 'critical' : 'warning',
          'message' => $blocked
            ? t('Your materials store tab of $@amount needs attention: @reason', [
              '@amount' => number_format($total, 2),
              '@reason' => $status['reason'],
            ])
            : t('You have an unpaid materials store tab of $@amount.', [
              '@amount' => number_format($total, 2),
            ]),
          'action_label' => $blocked ? t('Resolve store tab') : t('Pay store tab'),
          'action_url' => Url::fromRoute('makerspace_material_store.view_tab'),
          'icon' => $blocked ? 'exclamation-octagon' : 'basket',
          'weight' => $blocked ? 5 : 10,
          'cache_tags' => ['user:' . $account->id()],
        ];
      }
    }
    catch (\Throwable $e) {
      \Drupal::logger('makerspace_user_links')->warning('Member attention (tab) failed: @m', ['@m' => $e->getMessage()]);
    }
  }

  return $items;
}

/**
 * Implements hook_preprocess_menu().
 *
 * Makes "return to the page you were on" the default login behavior: for
 * anonymous visitors, append the current page as a ?destination= to the Log in
 * and Register menu links. login_destination has preserve_destination = TRUE,
 * so this destination wins over the neutral /home fallback rule — the user
 * lands back where they started instead of being redirected to a dashboard.
 */
function makerspace_user_links_preprocess_menu(array &$variables): void {
  if (\Drupal::currentUser()->isAuthenticated()) {
    return;
  }
  if (empty($variables['items'])) {
    return;
  }

  $request = \Drupal::request();
  $path_info = $request->getPathInfo();

  // Don't bounce people back to an auth page — that would loop.
  $auth_prefixes = ['/user/login', '/user/register', '/user/password', '/user/reset', '/user/logout'];
  foreach ($auth_prefixes as $prefix) {
    if (str_starts_with($path_info, $prefix)) {
      return;
    }
  }

  // Preserve the alias + query string the visitor currently sees.
  $destination = $request->getRequestUri();

  foreach ($variables['items'] as &$item) {
    $url = $item['url'] ?? NULL;
    if (!$url instanceof Url || !$url->isRouted()) {
      continue;
    }
    if (!in_array($url->getRouteName(), ['user.login', 'user.register'], TRUE)) {
      continue;
    }
    $options = $url->getOptions();
    // Respect an explicit destination if one is already present.
    if (!isset($options['query']['destination'])) {
      $options['query']['destination'] = $destination;
      $url->setOptions($options);
    }
  }

  // The injected destination depends on the current path, so vary the cache.
  $variables['#cache']['contexts'][] = 'url.path';
  $variables['#cache']['contexts'][] = 'url.query_args';
}

/**
 * Implements hook_makerspace_user_links_links().
 */
function makerspace_user_links_makerspace_user_links_links(UserInterface $account, AccountInterface $viewer, string $audience = 'admin'): array {
  $links = [];
  $route_parameters = ['user' => $account->id()];

  // 1. Member Audience (Self-service).
  if ($audience === 'member') {
    if ($account->id() === $viewer->id()) {
      $links[] = [
        'id' => 'edit_profile',
        'title' => t('Edit My Profile'),
        'route_name' => 'entity.user.edit_form',
        'route_parameters' => $route_parameters,
        'category' => t('Quick Links'),
        'weight' => -100,
      ];

      if (\Drupal::moduleHandler()->moduleExists('makerspace_material_store')) {
        $links[] = [
          'id' => 'my_tab',
          'title' => t('My Tab'),
          'route_name' => 'makerspace_material_store.view_tab',
          'category' => t('Quick Links'),
          'weight' => -90,
          'description' => t('View your unpaid items.'),
        ];
      }
    }
    return $links;
  }

  // 2. Facilitator Audience (Actions on others).
  if ($audience === 'facilitator') {
    if ($viewer->hasPermission('create badge_request content')) {
      $links[] = [
        'id' => 'add_badge',
        'title' => t('Add Badge'),
        'route_name' => 'node.add',
        'route_parameters' => ['node_type' => 'badge_request'],
        'route_options' => [
          'query' => [
            'edit' => [
              'field_member_to_badge' => [
                'widget' => [
                  0 => ['target_id' => $account->id()],
                ],
              ],
            ],
          ],
        ],
        'category' => t('Member Support'),
        'weight' => 20,
        'description' => t('Manually assign a badge to this user.'),
      ];
    }
    return $links;
  }

  // 3. Admin Audience (Deep management).
  if ($audience === 'admin') {
    // Masquerade Link.
    if (makerspace_user_links_can_masquerade($account, $viewer) && $account->id() != $viewer->id()) {
      if (\Drupal::moduleHandler()->moduleExists('masquerade')) {
        $links[] = [
          'id' => 'masquerade',
          'title' => t('Masquerade'),
          'route_name' => 'entity.user.masquerade',
          'route_parameters' => $route_parameters,
          'category' => t('Admin Actions'),
          'weight' => 10,
          'description' => t('Switch to this user session.'),
        ];
      }
    }

    // CiviCRM Contact Link.
    if ($viewer->hasPermission('access CiviCRM') && \Drupal::moduleHandler()->moduleExists('civicrm')) {
      try {
        /** @var \Drupal\civicrm\Civicrm $civicrm_service */
        $civicrm_service = \Drupal::service('civicrm');
        if ($civicrm_service) {
          $civicrm_service->initialize();
          if (function_exists('civicrm_api3')) {
            $result = civicrm_api3('UFMatch', 'get', [
              'uf_id' => $account->id(),
              'sequential' => 1,
            ]);

            if (!empty($result['values'][0]['contact_id'])) {
              $contact_id = $result['values'][0]['contact_id'];
              $links[] = [
                'id' => 'civicrm_contact',
                'title' => t('View CiviCRM Contact'),
                'uri' => 'internal:/civicrm/contact/view',
                'url_options' => [
                  'query' => [
                    'reset' => 1,
                    'cid' => $contact_id,
                  ],
                ],
                'category' => t('CiviCRM'),
                'weight' => 0,
                'description' => t('Open CiviCRM profile.'),
              ];
            }
          }
        }
      }
      catch (\Exception $e) {
        \Drupal::logger('makerspace_user_links')->error('CiviCRM error: @msg', ['@msg' => $e->getMessage()]);
      }
    }
  }

  return $links;
}

/**
 * Determines whether a viewer can masquerade as the given account.
 */
function makerspace_user_links_can_masquerade(UserInterface $account, AccountInterface $viewer): bool {
  if (!\Drupal::moduleHandler()->moduleExists('masquerade')) {
    return FALSE;
  }

  // Prefer native masquerade access logic when evaluating for the current user.
  if (function_exists('masquerade_target_user_access') && (string) \Drupal::currentUser()->id() === (string) $viewer->id()) {
    return masquerade_target_user_access($account);
  }

  // Fallback to mirrored core masquerade defaults when a non-current account
  // is being evaluated.
  if ($viewer->id() == 1) {
    return TRUE;
  }

  if ($account->id() == 1) {
    return $viewer->hasPermission('masquerade as super user');
  }

  if ($viewer->hasPermission('masquerade as any user')) {
    return TRUE;
  }

  foreach ($account->getRoles() as $role) {
    if (!$viewer->hasPermission('masquerade as ' . $role)) {
      return FALSE;
    }
  }

  return TRUE;
}

/**
 * Route helper to fetch the user from the current route.
 *
 * @deprecated
 *   Most callers should inject the route-match service instead.
 */
function makerspace_user_links_route_user(RouteMatchInterface $route_match): ?UserInterface {
  $route_user = $route_match->getParameter('user');
  if ($route_user instanceof UserInterface) {
    return $route_user;
  }
  if (is_numeric($route_user)) {
    return \Drupal::entityTypeManager()->getStorage('user')->load((int) $route_user);
  }
  return NULL;
}
