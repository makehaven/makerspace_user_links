/**
 * Implements hook_theme().
 */
function makerspace_user_links_theme(): array {
  return [
    'makerspace_user_links_list' => [
      'variables' => [
        'link_groups' => [],
      ],
      'template' => 'makerspace-user-links-list',
    ],
    'makerspace_user_links_menu_cards' => [
      'variables' => [
        'title' => '',
        'cards' => [],
        'groups' => [],
      ],
      'template' => 'menu-cards',
    ],
    'makerspace_user_links_member_attention' => [
      'variables' => [
        'items' => [],
      ],
      'template' => 'member-attention',
    ],
    'makerspace_user_links_member_index' => [
      'variables' => [
        'sections' => [],
      ],
      'template' => 'member-index',
    ],
    'makerspace_user_links_member_bar' => [
      'variables' => [
        'home_url' => '',
        'home_active' => FALSE,
        'site_url' => '',
        'logo_url' => '',
        'search_url' => '',
        'primary' => [],
        'dashboards' => [],
        'account' => [],
        'display_name' => '',
        'membership_url' => '',
        'membership_active' => FALSE,
      ],
      'template' => 'member-bar',
    ],
    'makerspace_user_links_member_return' => [
      'variables' => [
        'home_url' => '',
        'account' => [],
      ],
      'template' => 'member-return',
    ],
  ];
}

/**
 * Implements hook_page_top().
 *
 * Puts the member bar above every page a logged-in person sees in the member
 * (Gin) theme, for members, and for staff (who have core's Navigation
 * sidebar) holding 'see member bar with navigation'; see MemberBar::shows().
 * Public (d11) pages get the Member Resources button instead; see
 * makerspace_user_links_preprocess_page().
 */
function makerspace_user_links_page_top(array &$page_top): void {
  if (!MemberBar::shows(\Drupal::currentUser())) {
    return;
  }
  $theme = \Drupal::theme()->getActiveTheme()->getName();
  if (!in_array($theme, MemberBar::THEMES, TRUE)) {
    return;
  }
  $page_top['makerspace_member_bar'] = \Drupal::service('makerspace_user_links.member_bar')->placeholder();
}

/**
 * Implements hook_preprocess_HOOK() for page.
 *
 * On the public theme a logged-in member gets one gold "Member Resources"
 * button in the header's red top strip, beside the site search (where
 * visitors see Log in), rather than the whole member bar: public pages keep
 * a single navigation bar and a single search box (JR 2026-10-13).
 */
function makerspace_user_links_preprocess_page(array &$variables): void {
  if (\Drupal::theme()->getActiveTheme()->getName() !== MemberBar::PUBLIC_THEME) {
    return;
  }
  // The lazy builder decides per viewer; anonymous visitors and staff (who
  // have the Navigation sidebar) get nothing.
  if (\Drupal::currentUser()->isAnonymous()) {
    return;
  }
  $variables['page']['top_header']['makerspace_member_return'] = \Drupal::service('makerspace_user_links.member_bar')->publicReturnPlaceholder();
}

/**
 * Implements hook_makerspace_member_attention().
 *
 * Starter implementation: surface an unpaid materials-store tab. Other signals
 * (overdue lending, upcoming appointment, unsigned waiver) should be added by
 * the modules that own that data — see makerspace_user_links.api.php.
 */
function makerspace_user_links_makerspace_member_attention(AccountInterface $account): array {
  $items = [];

  // Unpaid materials tab — only if the store module is installed.
  if (\Drupal::moduleHandler()->moduleExists('makerspace_material_store')
    && \Drupal::hasService('makerspace_material_store.tab_limit')) {
    try {
      // Skip the eligibility gates (terms acceptance, Stripe account) so we get
      // the member's REAL outstanding balance. Those gates are "you haven't
      // opted into the tab yet" prompts that belong on the add-to-tab action
      // (StoreController) — not a standing critical banner on /resources. We
      // only nag members who actually have a materials-store tab: a real
      // balance, or an explicit failed-payment/limit block.
      $status = \Drupal::service('makerspace_material_store.tab_limit')->getStatus($account, 0.0, [
        'skip_terms' => TRUE,
        'skip_stripe' => TRUE,
      ]);
      $total = (float) ($status['total'] ?? 0);
      $blocked = !empty($status['blocked']);

      // Failed-payment block (field_store_tab_blocked) early-returns from
      // getStatus with total = 0. Surface it even at $0 pending because the
      // account has been explicitly flagged — that's the most urgent case.
      if ($blocked && $total <= 0) {
        $reason = !empty($status['reason']) ? $status['reason'] : t('Your materials store tab is blocked due to a payment issue.');
        $items[] = [
          'id' => 'material_tab_blocked',
          'severity' => 'critical',
          'message' => $reason,
          'action_label' => t('Resolve store tab'),
          'action_url' => Url::fromRoute('makerspace_material_store.view_tab'),
          'icon' => 'exclamation-octagon',
          'weight' => 5,
          'cache_tags' => ['user:' . $account->id()],
        ];
      }
      // Outstanding balance — a member who is in the program and owes money.
      // Critical if it has hit a limit (blocked), otherwise a gentle reminder.
      elseif ($total > 0) {
        $items[] = [
          'id' => $blocked ? 'material_tab_blocked' : 'material_tab',
          'severity' => $blocked ? 'critical' : 'warning',
          'message' => $blocked
            ? t('Your materials store tab of $@amount needs attention: @reason', [
              '@amount' => number_format($total, 2),
              '@reason' => $status['reason'],
            ])
            : t('You have an unpaid materials store tab of $@amount.', [
              '@amount' => number_format($total, 2),
            ]),
          'action_label' => $blocked ? t('Resolve store tab') : t('Pay store tab'),
          'action_url' => Url::fromRoute('makerspace_material_store.view_tab'),
          'icon' => $blocked ? 'exclamation-octagon' : 'basket',
          'weight' => $blocked ? 5 : 10,
          'cache_tags' => ['user:' . $account->id()],
        ];
      }
    }
    catch (\Throwable $e) {
      \Drupal::logger('makerspace_user_links')->warning('Member attention (tab) failed: @m', ['@m' => $e->getMessage()]);
    }
  }

  return $items;
}

/**
 * Implements hook_preprocess_menu().
 *
 * Makes "return to the page you were on" the default login behavior: for
 * anonymous visitors, append the current page as a ?destination= to the Log in
 * and Register menu links. login_destination has preserve_destination = TRUE,
 * so this destination wins over the neutral /home fallback rule — the user
 * lands back where they started instead of being redirected to a dashboard.
 */
function makerspace_user_links_preprocess_menu(array &$variables): void {
  if (\Drupal::currentUser()->isAuthenticated()) {
    return;
  }
  if (empty($variables['items'])) {
    return;
  }

  $request = \Drupal::request();
  $path_info = $request->getPathInfo();

  // Don't bounce people back to an auth page — that would loop.
  $auth_prefixes = ['/user/login', '/user/register', '/user/password', '/user/reset', '/user/logout'];
  foreach ($auth_prefixes as $prefix) {
    if (str_starts_with($path_info, $prefix)) {
      return;
    }
  }

  // Preserve the alias + query string the visitor currently sees.
  $destination = $request->getRequestUri();

  foreach ($variables['items'] as &$item) {
    $url = $item['url'] ?? NULL;
    if (!$url instanceof Url || !$url->isRouted()) {
      continue;
    }
    if (!in_array($url->getRouteName(), ['user.login', 'user.register'], TRUE)) {
      continue;
    }
    $options = $url->getOptions();
    // Respect an explicit destination if one is already present.
    if (!isset($options['query']['destination'])) {
      $options['query']['destination'] = $destination;
      $url->setOptions($options);
    }
  }

  // The injected destination depends on the current path, so vary the cache.
  $variables['#cache']['contexts'][] = 'url.path';
  $variables['#cache']['contexts'][] = 'url.query_args';
}

/**
 * Implements hook_makerspace_user_links_links().
 */
function makerspace_user_links_makerspace_user_links_links(UserInterface $account, AccountInterface $viewer, string $audience = 'admin'): array {
  $links = [];
  $route_parameters = ['user' => $account->id()];

  // 1. Member Audience (Self-service).
  if ($audience === 'member') {
    if ($account->id() === $viewer->id()) {
      $links[] = [
        'id' => 'edit_profile',
        'title' => t('Edit My Profile'),
        'route_name' => 'entity.user.edit_form',
        'route_parameters' => $route_parameters,
        'category' => t('Quick Links'),
        'weight' => -100,
      ];

      if (\Drupal::moduleHandler()->moduleExists('makerspace_material_store')) {
        $links[] = [
          'id' => 'my_tab',
          'title' => t('My Tab'),
          'route_name' => 'makerspace_material_store.view_tab',
          'category' => t('Quick Links'),
          'weight' => -90,
          'description' => t('View your unpaid items.'),
        ];
      }
    }
    return $links;
  }

  // 2. Facilitator Audience (Actions on others).
  if ($audience === 'facilitator') {
    if ($viewer->hasPermission('create badge_request content')) {
      $links[] = [
        'id' => 'add_badge',
        'title' => t('Add Badge'),
        'route_name' => 'node.add',
        'route_parameters' => ['node_type' => 'badge_request'],
        'route_options' => [
          'query' => [
            'edit' => [
              'field_member_to_badge' => [
                'widget' => [
                  0 => ['target_id' => $account->id()],
                ],
              ],
            ],
          ],
        ],
        'category' => t('Member Support'),
        'weight' => 20,
        'description' => t('Manually assign a badge to this user.'),
      ];
    }
    return $links;
  }

  // 3. Admin Audience (Deep management).
  if ($audience === 'admin') {
    // Masquerade Link.
    if (makerspace_user_links_can_masquerade($account, $viewer) && $account->id() != $viewer->id()) {
      if (\Drupal::moduleHandler()->moduleExists('masquerade')) {
        $links[] = [
          'id' => 'masquerade',
          'title' => t('Masquerade'),
          'route_name' => 'entity.user.masquerade',
          'route_parameters' => $route_parameters,
          'category' => t('Admin Actions'),
          'weight' => 10,
          'description' => t('Switch to this user session.'),
        ];
      }
    }

    // CiviCRM Contact Link.
    if ($viewer->hasPermission('access CiviCRM') && \Drupal::moduleHandler()->moduleExists('civicrm')) {
      try {
        /** @var \Drupal\civicrm\Civicrm $civicrm_service */
        $civicrm_service = \Drupal::service('civicrm');
        if ($civicrm_service) {
          $civicrm_service->initialize();
          if (function_exists('civicrm_api3')) {
            $result = civicrm_api3('UFMatch', 'get', [
              'uf_id' => $account->id(),
              'sequential' => 1,
            ]);

            if (!empty($result['values'][0]['contact_id'])) {
              $contact_id = $result['values'][0]['contact_id'];
              $links[] = [
                'id' => 'civicrm_contact',
                'title' => t('View CiviCRM Contact'),
                'uri' => 'internal:/civicrm/contact/view',
                'url_options' => [
                  'query' => [
                    'reset' => 1,
                    'cid' => $contact_id,
                  ],
                ],
                'category' => t('CiviCRM'),
                'weight' => 0,
                'description' => t('Open CiviCRM profile.'),
              ];
            }
          }
        }
      }
      catch (\Exception $e) {
        \Drupal::logger('makerspace_user_links')->error('CiviCRM error: @msg', ['@msg' => $e->getMessage()]);
      }
    }
  }

  return $links;
}

/**
 * Implements hook_ENTITY_TYPE_view() for node.
 *
 * Until staff approve a new account (member_pending_approval, no member
 * role yet), every link on Member Resources is greyed out and nothing said
 * why (staff feedback 2026-08). Say so at the top of the page.
 */
function makerspace_user_links_node_view(array &$build, NodeInterface $node, EntityViewDisplayInterface $display, string $view_mode): void {
  if ($view_mode !== 'full') {
    return;
  }
  $alias = \Drupal::service('path_alias.manager')->getAliasByPath('/node/' . $node->id());
  if ($alias !== '/member/resources') {
    return;
  }
  $build['#cache']['contexts'][] = 'user.roles';
  $account = \Drupal::currentUser();
  if (!$account->hasRole('member_pending_approval') || $account->hasRole('member')) {
    return;
  }
  // A plain inline notice: the public theme turns status messages into a
  // corner toast that fades, and this has to stay beside the greyed links.
  $build['makerspace_pending_notice'] = [
    '#type' => 'html_tag',
    '#tag' => 'div',
    '#attributes' => ['class' => ['alert', 'alert-info', 'mh-pending-notice'], 'role' => 'status'],
    '#value' => t('Your membership will be verified by a staff member soon. This page opens up once that is done. Questions? Email <a href=":mail">membership@makehaven.org</a>.', [':mail' => 'mailto:membership@makehaven.org']),
    '#weight' => -100,
  ];
}

/**
 * Implements hook_entity_operation().
 *
 * Adds "Member page" (/user/{uid}/main) to the row menu on the people list,
 * beside Edit, View and Masquerade as, so staff reach it in one click.
 */
function makerspace_user_links_entity_operation(EntityInterface $entity): array {
  if (!$entity instanceof UserInterface || $entity->isAnonymous() || !\Drupal::moduleHandler()->moduleExists('profile')) {
    return [];
  }
  $url = Url::fromRoute('profile.user_page.single', [
    'user' => $entity->id(),
    'profile_type' => 'main',
  ]);
  if (!$url->access()) {
    return [];
  }
  return [
    'makerspace_member_page' => [
      'title' => t('Member page'),
      'url' => $url,
      'weight' => 20,
    ],
  ];
}

/**
 * Implements hook_form_FORM_ID_alter() for user_form.
 *
 * The profile photo, bio and interests live on the member profile
 * (/user/{uid}/main), not the account form, and nothing on the account form
 * said so: a member looking for where to add a photo gave up (2026-09).
 */
function makerspace_user_links_form_user_form_alter(array &$form, FormStateInterface $form_state): void {
  $account = $form_state->getFormObject()->getEntity();
  if (!$account instanceof UserInterface || $account->isNew() || !\Drupal::moduleHandler()->moduleExists('profile')) {
    return;
  }
  $url = Url::fromRoute('profile.user_page.single', [
    'user' => $account->id(),
    'profile_type' => 'main',
  ]);
  if (!$url->access()) {
    return;
  }
  $own = (int) $account->id() === (int) \Drupal::currentUser()->id();
  $form['makerspace_member_profile_pointer'] = [
    '#type' => 'html_tag',
    '#tag' => 'p',
    '#weight' => -100,
    '#attributes' => ['class' => ['mh-member-profile-pointer']],
    'text' => [
      '#markup' => $own
        ? t('Looking for your profile photo, bio or interests? They are on your member profile.')
        : t('Profile photo, bio and interests are on the member profile.'),
      '#suffix' => ' ',
    ],
    'link' => [
      '#type' => 'link',
      '#title' => $own ? t('Edit your member profile') : t('Edit member profile'),
      '#url' => $url,
    ],
  ];
}

/**
 * Implements hook_form_FORM_ID_alter() for menu_edit_form.
 *
 * Since 2026-10-06 the member bar, journey pages and Member Resources are
 * built from the menus below, whose links are defined in this module's
 * links.menu.yml. Staff looking in the old Member menu could not find them
 * (2026-10-14: a dead "Table for MakeHaven" link), so the Member menu and
 * each of these menus point to all of them and say what can be edited here.
 */
function makerspace_user_links_form_menu_edit_form_alter(array &$form, FormStateInterface $form_state): void {
  $menus = [
    'your-dashboards' => t('Dashboards'),
    'member-nav' => t('Member bar'),
    'journey-make' => t('Make'),
    'journey-learn' => t('Learn'),
    'journey-connect' => t('Connect'),
    'journey-grow' => t('Grow'),
    'member-membership' => t('My Membership'),
    'member-account' => t('Member account'),
  ];
  $current = $form_state->getFormObject()->getEntity()->id();
  if ($current !== 'menu-member-menu' && !isset($menus[$current])) {
    return;
  }
  $items = [];
  foreach ($menus as $id => $label) {
    $items[] = $id === $current
      ? ['#markup' => '<strong>' . $label . '</strong>']
      : [
        '#type' => 'link',
        '#title' => $label,
        '#url' => Url::fromRoute('entity.menu.edit_form', ['menu' => $id]),
      ];
  }
  $form['makerspace_member_menus'] = [
    '#type' => 'container',
    '#weight' => -100,
    '#attributes' => ['class' => ['messages', 'messages--status']],
    'text' => [
      '#type' => 'html_tag',
      '#tag' => 'p',
      '#value' => $current === 'menu-member-menu'
        ? t('The member bar, Dashboards, journey pages and Member Resources are not built from this menu. Edit their links here:')
        : t('Links that come with the site can be turned on or off, reordered or moved here; their title and address are set in code. Links added with "Add link" are fully editable. Other member menus:'),
    ],
    'menus' => [
      '#theme' => 'item_list',
      '#items' => $items,
      '#attributes' => ['class' => ['inline']],
    ],
  ];
}

/**
 * Implements hook_navigation_menu_link_tree_alter().
 *
 * The staff sidebar shows the your-dashboards menu too (2026-10-14). Route
 * access alone lets anyone open some of its links (CiviCRM gates itself,
 * Borrowed tools and Facilitator utilities are open pages), so apply the
 * same mh_access_permission filter the member bar uses. mh_access_callback
 * is not applied: its only user, GrowAccess, passes everyone with the
 * sidebar, and a per-user check would need a per-user cache context.
 */
function makerspace_user_links_navigation_menu_link_tree_alter(array &$tree): void {
  $account = \Drupal::currentUser();
  foreach ($tree as $key => $element) {
    if ($element->link->getMenuName() !== 'your-dashboards') {
      continue;
    }
    $permission = $element->link->getOptions()['mh_access_permission'] ?? NULL;
    if ($permission && !$account->hasPermission($permission)) {
      unset($tree[$key]);
    }
  }
}

/**
 * Determines whether a viewer can masquerade as the given account.
 */
function makerspace_user_links_can_masquerade(UserInterface $account, AccountInterface $viewer): bool {
  if (!\Drupal::moduleHandler()->moduleExists('masquerade')) {
    return FALSE;
  }

  // Prefer native masquerade access logic when evaluating for the current user.
  if (function_exists('masquerade_target_user_access') && (string) \Drupal::currentUser()->id() === (string) $viewer->id()) {
    return masquerade_target_user_access($account);
  }

  // Fallback to mirrored core masquerade defaults when a non-current account
  // is being evaluated.
  if ($viewer->id() == 1) {
    return TRUE;
  }

  if ($account->id() == 1) {
    return $viewer->hasPermission('masquerade as super user');
  }

  if ($viewer->hasPermission('masquerade as any user')) {
    return TRUE;
  }

  foreach ($account->getRoles() as $role) {
    if (!$viewer->hasPermission('masquerade as ' . $role)) {
      return FALSE;
    }
  }

  return TRUE;
}

/**
 * Route helper to fetch the user from the current route.
 *
 * @deprecated
 *   Most callers should inject the route-match service instead.
 */
function makerspace_user_links_route_user(RouteMatchInterface $route_match): ?UserInterface {
  $route_user = $route_match->getParameter('user');
  if ($route_user instanceof UserInterface) {
    return $route_user;
  }
  if (is_numeric($route_user)) {
    return \Drupal::entityTypeManager()->getStorage('user')->load((int) $route_user);
  }
  return NULL;
}

/**
 * Implements hook_webform_submission_presave().
 *
 * Staff often report a problem while masquerading as the member who hit it,
 * because that is the only way to see the page as they see it. The website
 * feedback form fills reported_by_* from [current-user:*], so those reports
 * were attributed to the member: the "we got your report" email and every
 * later status email from the feedback board went to the member, and the
 * staffer who filed it never heard back (2026-09-28: three of the last ten
 * staff reports).
 *
 * Record the real person as the reporter and keep the viewed-as member in
 * masquerading_as_* so the context is not lost.
 */
function makerspace_user_links_webform_submission_presave($webform_submission): void {
  if ($webform_submission->getWebform()->id() !== 'website_feedback' || !$webform_submission->isNew()) {
    return;
  }
  if (!\Drupal::moduleHandler()->moduleExists('masquerade') || !\Drupal::service('masquerade')->isMasquerading()) {
    return;
  }

  $original_uid = (int) \Drupal::service('session')->getMetadataBag()->getMasquerade();
  $original = $original_uid ? \Drupal::entityTypeManager()->getStorage('user')->load($original_uid) : NULL;
  if (!$original instanceof UserInterface) {
    return;
  }

  $data = $webform_submission->getData();
  $data['masquerading_as_uid'] = $data['reported_by_uid'] ?? (string) \Drupal::currentUser()->id();
  $data['masquerading_as_name'] = $data['reported_by_name'] ?? \Drupal::currentUser()->getDisplayName();
  $data['reported_by_uid'] = (string) $original->id();
  $data['reported_by_name'] = $original->getDisplayName();
  $data['reported_by_mail'] = (string) $original->getEmail();
  $webform_submission->setData($data);
}
